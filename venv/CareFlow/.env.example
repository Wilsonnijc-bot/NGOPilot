# CareFlow Docker configuration
# Copy to .env only if you need to override defaults or provide API keys.

CAREFLOW_VERSION=0.4.8
CAREFLOW_BACKEND_IMAGE=wilson54311/careflow-backend
CAREFLOW_FRONTEND_IMAGE=wilson54311/careflow-frontend

APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=/app/data
ASSET_DIR=/app/data/asset
DATABASE_URL=sqlite:////app/data/careflow.db
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080

# Leave keys blank to use CareFlow's mock-mode fallbacks.
LLM_PROVIDER=auto

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=careflow-gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL=gpt-5-mini

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_ASR_MODEL=fun-asr
