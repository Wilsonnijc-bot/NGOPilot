# RosterCopiilot deployment environment
# Copy to /etc/rostercopiilot/rostercopiilot.env (root-owned, chmod 640,
# group rostercopiilot). NEVER commit the real file to git.

# --- Runtime mode ----------------------------------------------------------
# "production" disables the interactive API docs (/docs, /redoc, /openapi.json)
# unless ROSTER_ENABLE_DOCS is explicitly turned on.
ROSTER_ENV=production

# Persistent data locations (must live outside the release directory so they
# survive upgrades and rollbacks). systemd StateDirectory creates and owns
# /var/lib/rostercopiilot.
ROSTER_DB_PATH=/var/lib/rostercopiilot/roster.db
ROSTER_EXPORT_DIR=/var/lib/rostercopiilot/exports

# --- Cross-origin policy ---------------------------------------------------
# Same-origin deployment (frontend + API behind one Nginx origin) needs NO
# cross-origin access. Leave empty to disable CORS entirely. To allow specific
# development origins, provide a comma-separated allowlist. Never use "*".
ROSTER_CORS_ORIGINS=

# --- Upload cap ------------------------------------------------------------
# Per-workbook upload size limit in megabytes. Keep Nginx client_max_body_size
# slightly above this so the app returns the friendly 413.
ROSTER_MAX_UPLOAD_MB=10

# --- Optional application-level API token ----------------------------------
# Off by default. The browser demo is gated at the reverse proxy (HTTP Basic
# over HTTPS), because a browser single-page app cannot safely hold a shared
# secret. Set this ONLY to additionally lock down direct/scripted API access;
# when set, every non-health request must send:
#   Authorization: Bearer <token>   or   X-API-Key: <token>
# Generate with: openssl rand -hex 32
# ROSTER_API_TOKEN=

# --- Interactive docs override (optional) ----------------------------------
# Force-enable API docs even in production (not recommended for public demos).
# ROSTER_ENABLE_DOCS=0
