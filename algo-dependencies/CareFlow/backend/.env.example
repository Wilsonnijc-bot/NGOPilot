# ─────────────────────────────────────────────────────────────
# CareFlow 後端設定範本（v0.4.0-rc6.1 重構：三路 AI 獨立路由）
# 使用方法：cp .env.example .env  然後填入下方的 key
# ─────────────────────────────────────────────────────────────
# 三路 AI 設計：
#   ┌─────────────┬─────────────────────────────────────┬──────────────────────────────┐
#   │  modality   │  provider                            │  default model / deployment  │
#   ├─────────────┼─────────────────────────────────────┼──────────────────────────────┤
#   │  text/推理  │  DeepSeek 官方 (OpenAI 相容)         │  deepseek-v4-pro             │
#   │  vision     │  Azure OpenAI                        │  gpt-5-mini (deployment)     │
#   │  asr/語音   │  Bailian / DashScope                 │  fun-asr                     │
#   └─────────────┴─────────────────────────────────────┴──────────────────────────────┘
# 三路完全獨立 — 任一路缺 key 即各自退回 mock，不影響其餘兩路。

# ─── 文字推理：DeepSeek 官方 ───────────────────────────────────
# 申請：https://platform.deepseek.com → API Keys
# 可選模型：deepseek-v4-pro (主推) / deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash

# ─── 視覺抽取：Azure OpenAI · GPT-5-mini ──────────────────────
# 在 Azure Portal → Azure OpenAI Resource → Deployments 建立一個
# GPT-5-mini 部署，把 deployment name 填到下方 AZURE_OPENAI_DEPLOYMENT。
# Endpoint 格式：https://<your-resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=careflow-gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL=gpt-5-mini

# ─── 語音轉錄：Bailian / DashScope · fun-asr ──────────────────
# 申請：阿里雲 DashScope 控制台
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_ASR_MODEL=fun-asr

# ─── 應用 ─────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/careflow.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Legacy / 已停用（保留欄位避免 .env 載入錯誤） ───────────
# LLM_PROVIDER=auto                # legacy；rc6 已忽略
# HUNYUAN_API_KEY=
# OPENAI_API_KEY=                  # 已棄用 (rc6.1 改走 Azure OpenAI)
# OPENAI_BASE_URL=
# OPENAI_VISION_MODEL=
# AZURE_FALLBACK_ENABLED=false
# PRIMARY_VISION_PROVIDER=azure
